    <fragment
        android:id="@+id/policyFragment"
        android:name="com.witvpn.ikev2.presentation.ui.PolicyFragment"
        android:label="PolicyFragment" />
    <fragment
        android:id="@+id/OTPFragment"
        android:name="com.witvpn.ikev2.presentation.ui.otp.OTPFragment"
        android:label="OTPFragment">
        <action
            android:id="@+id/action_OTPFragment_to_policyFragment"
            app:destination="@id/policyFragment" />
        <action
            android:id="@+id/action_OTPFragment_to_confirmOTPFragment"
            app:destination="@id/confirmOTPFragment"
            app:popUpTo="@id/OTPFragment"
            app:popUpToInclusive="true">
            <argument
                android:name="emailArg"
                app:argType="string" />
        </action>
        <action
            android:id="@+id/action_OTPFragment_to_mnemonicFragment"
            app:destination="@id/mnemonicFragment" />
        <action android:id="@+id/action_OTPFragment_to_QRFragment" app:destination="@id/QRFragment"/>
        <action android:id="@+id/action_OTPFragment_to_splashFragment" app:destination="@id/splashFragment"/>
        <action
            android:id="@+id/action_OTPFragment_to_splitTunnelFragment"
            app:destination="@id/splitTunnelFragment" />
    </fragment>
    <fragment
        android:id="@+id/splitTunnelFragment"
        android:name="com.witvpn.ikev2.presentation.ui.splittunnel.SplitTunnelFragment"
        android:label="SplitTunnelFragment"
        tools:layout="@layout/fragment_split_tunnel" />
    <fragment
        android:id="@+id/confirmOTPFragment"
        android:name="com.witvpn.ikev2.presentation.ui.otp.ConfirmOTPFragment"
        android:label="ConfirmOTPFragment">
        <argument
            android:name="emailArg"
            app:argType="string" />
        <action
            android:id="@+id/action_confirmOTPFragment_to_splashFragment"
            app:destination="@id/splashFragment"
            app:popUpTo="@id/confirmOTPFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/graysBillingFragment"
        android:name="com.witvpn.ikev2.presentation.ui.billing.grays.GraysBillingFragment"
        android:label="WebViewFragment" >
        <action android:id="@+id/action_graysBillingFragment_to_splashFragment" app:destination="@id/splashFragment"/>
    </fragment>
    <fragment
        android:id="@+id/mnemonicFragment"
        android:name="com.witvpn.ikev2.presentation.ui.entropy.MnemonicFragment"
        android:label="MnemonicFragment" >
        <action
            android:id="@+id/action_mnemonicFragment_to_splashFragment"
            app:destination="@id/splashFragment" />
    </fragment>
    <fragment
        android:id="@+id/restoreFragment"
        android:name="com.witvpn.ikev2.presentation.ui.restoreAccount.RestoreFragment"
        android:label="Restore"
        tools:layout="@layout/fragment_restore"
        />
    <fragment
        android:id="@+id/QRFragment"
        android:name="com.witvpn.ikev2.presentation.ui.qr.QRFragment"
        android:label="QRFragment" />
    <fragment
        android:id="@+id/connectFragment"
        android:name="com.witvpn.ikev2.presentation.ui.connect.ConnectFragment"
        android:label="ConnectFragment" />
    <fragment
        android:id="@+id/serversFragment"
        android:name="com.witvpn.ikev2.presentation.ui.servers.ServersFragment"
        android:label="ServersFragment" />

    <fragment
        android:id="@+id/billingFragment"
        android:name="com.witvpn.ikev2.presentation.ui.billing.BillingFragment"
        android:label="billing"
        />
    <fragment
        android:id="@+id/supportFragment"
        android:name="com.witvpn.ikev2.presentation.ui.support.SupportFragment"
        android:label="SupportFragment"
        tools:layout="@layout/fragment_support" />
</navigation>