<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="22dp">

    <com.witvpn.ikev2.presentation.widget.AuthToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:atb_left="@drawable/ic_delete"
        app:atb_title="Restore account"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteX="30dp" />

    <include layout="@layout/view_input_new"
        android:id="@+id/input_mnemonic"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_marginTop="23dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbar"/>

    <ImageView
        android:id="@+id/copy_icon"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_margin="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/input_mnemonic"
        app:layout_constraintEnd_toEndOf="@+id/input_mnemonic"
        app:srcCompat="@drawable/baseline_copy_all_24"
        app:tint="@android:color/darker_gray" />

    <TextView
        android:id="@+id/restore_button"
        style="@style/ActionButton.State"
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:text="@string/restore_from_mnemonic"
        android:textColor="#ffffff"
        android:layout_marginTop="46dp"
        app:layout_constraintEnd_toEndOf="@+id/input_mnemonic"
        app:layout_constraintStart_toStartOf="@+id/input_mnemonic"
        app:layout_constraintTop_toBottomOf="@+id/input_mnemonic" />


</androidx.constraintlayout.widget.ConstraintLayout>
