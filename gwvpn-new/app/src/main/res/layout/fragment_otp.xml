<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent" xmlns:app="http://schemas.android.com/apk/res-auto"
        android:orientation="vertical"
        android:background="@color/colorPrimary"
        android:padding="@dimen/padding_common">

    <ImageView
            android:id="@+id/close"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginBottom="16dp"
            app:srcCompat="@drawable/ic_delete" />

    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:text="@string/account_save_key_description"/>

    <Button
            android:id="@+id/account_key"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            android:text="@string/account_save_key"
            android:textAllCaps="false"
            android:background="@drawable/bg_input_code_selected"/>

    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:paddingTop="22dp"
                  android:weightSum="2">
        <LinearLayout android:layout_height="wrap_content"
                      android:layout_width="match_parent"
                      android:orientation="vertical"
                      android:layout_weight="1"
                      android:paddingEnd="20dp">
            <TextView android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="@string/current_subscribe"
                    android:paddingBottom="10dp"/>
            <TextView
                    android:id="@+id/subscribe_type"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="@string/subs_type_premium"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="16dp"
                    android:background="@drawable/bg_input_code_unfocused"/>
        </LinearLayout>
        <LinearLayout android:layout_height="wrap_content"
                      android:layout_width="match_parent"
                      android:orientation="vertical"
                      android:layout_weight="1">
            <TextView android:layout_height="wrap_content"
                      android:layout_width="wrap_content"
                      android:text="@string/current_subscribe_ends"
                      android:paddingBottom="10dp"/>
            <TextView
                    android:id="@+id/subscribe_ends"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:text="@string/sub_end_unlimited"
                    android:maxLines="1"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp"
                    android:paddingStart="16dp"
                    android:background="@drawable/bg_input_code_unfocused"/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:paddingTop="22dp">
        <LinearLayout android:id="@+id/share_key_qr"
                      android:layout_width="111dp"
                      android:layout_height="96dp"
                      android:orientation="vertical"
                      android:gravity="center_vertical"
                      android:padding="10dp"
                      android:background="@drawable/bg_input_code_selected_gradient">
            <ImageView android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       app:tint="@android:color/white"
                       android:src="@drawable/baseline_qr_code_32"/>
            <TextView android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:paddingTop="5dp"
                      android:text="@string/share_qr"/>
        </LinearLayout>

        <View android:layout_width="16dp" android:layout_height="0dp"/>

        <LinearLayout android:id="@+id/account_exit"
                      android:layout_width="111dp"
                      android:layout_height="96dp"
                      android:orientation="vertical"
                      android:gravity="center_vertical"
                      android:padding="10dp"
                      android:background="@drawable/bg_input_code_selected_gradient">
            <ImageView android:layout_width="wrap_content"
                       android:layout_height="wrap_content"
                       app:tint="@android:color/white"
                       android:src="@drawable/baseline_logout_24"/>
            <TextView android:layout_width="wrap_content"
                      android:layout_height="wrap_content"
                      android:paddingTop="5dp"
                      android:text="@string/logout"/>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent"
                 android:layout_height="match_parent">
        <TextView
                android:layout_gravity="bottom"
                android:id="@+id/delete_profile"
                style="@style/ActionButton.State"
                android:layout_width="match_parent"
                android:text="@string/delete_profile"
                android:textAllCaps="false"
                android:textColor="#ffffff" />
    </FrameLayout>
</LinearLayout>
