<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="80dp"
    android:paddingBottom="70dp"
    android:paddingEnd="20dp"
    android:divider="@color/colorAccent"
    android:dividerHeight="2dp"
    android:showDividers="middle|end">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        app:srcCompat="@drawable/logo_grey"
        android:paddingBottom="50dp" />

    <TextView
            android:id="@+id/account_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_tab_3"
            android:textAppearance="?android:attr/textAppearanceLarge"
            android:textSize="14sp"
            android:gravity="center"
            app:drawableTint="@android:color/white"
            android:paddingStart="5dp"
            android:paddingBottom="10dp"
            android:paddingTop="20dp"
            app:drawableStartCompat="@drawable/ic_baseline_account_circle_24"
            android:drawablePadding="10dp" />
    
<!--    <com.google.android.material.divider.MaterialDivider-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="1dp"-->
<!--        android:layout_marginTop="20dp"-->
<!--        android:layout_marginBottom="10dp"-->
<!--        app:dividerColor="@color/colorTextGray" />-->

    <TextView
        android:id="@+id/mainLeftMenuQR"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/save_code"
        android:fontFamily="@font/campton_book"
        android:textSize="14sp"
        android:gravity="center"
        app:drawableTint="@android:color/white"
        android:paddingStart="5dp"
        android:paddingBottom="10dp"
        android:paddingTop="20dp"
        app:drawableStartCompat="@drawable/baseline_qr_code_32"
        android:drawablePadding="10dp" />

    <TextView
            android:id="@+id/mainLeftMenuTelegramChanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/go_to_telegram_channel"
            android:fontFamily="@font/campton_book"
            android:textSize="14sp"
            android:gravity="center"
            app:drawableTint="@android:color/white"
            android:paddingStart="5dp"
            android:paddingBottom="10dp"
            android:paddingTop="20dp"
            app:drawableStartCompat="@drawable/baseline_telegram_32"
            android:drawablePadding="10dp" />

    <TextView
            android:id="@+id/mainLeftMenuSupport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/support"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/campton_book"
            android:textSize="14sp"
            app:drawableTint="@android:color/white"
            android:paddingStart="5dp"
            android:paddingBottom="10dp"
            android:gravity="center"
            android:paddingTop="20dp"
            app:drawableStartCompat="@drawable/baseline_help_outline_32"
            android:drawablePadding="10dp" />

</LinearLayout>