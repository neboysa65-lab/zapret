<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131519">

    <!--
         focusableInTouchMode lets the container take the focus back when the
         search field releases it, so the cursor does not linger in the field
         after the keyboard is dismissed.
    -->
    <LinearLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_welcome"
        android:focusableInTouchMode="true"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp">

        <!--
             Everything above the search field lives in this block, so the
             screen can collapse it in the expanded (full-screen list) state:
             the search field then sits at the top of the visible area and
             the app list gets all the remaining space. The state is entered
             by scrolling the list or focusing the search field and is left
             via the back arrow next to the field or the system Back gesture
             (see SplitTunnelFragment.applyHeaderState / setExpanded).
        -->
        <LinearLayout
            android:id="@+id/collapsing_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:transitionGroup="true">

            <ImageView
                android:id="@+id/btnLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:contentDescription="@string/split_tunnel_back"
                android:src="@drawable/ic_arrow_left" />

            <TextView
                style="@style/Title.Large"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/split_tunneling" />

            <TextView
                style="@style/Subhead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/split_tunnel_description" />

            <LinearLayout
                android:id="@+id/reconnect_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rectangle_r16"
                android:backgroundTint="#1B1E24"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/blue" />

                <TextView
                    style="@style/Caption.1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/split_tunnel_reconnect_notice"
                    android:textColor="@color/white" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/mode_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rectangle_r16"
                android:backgroundTint="#1B1E24"
                android:orientation="vertical"
                android:paddingVertical="4dp">

                <LinearLayout
                    android:id="@+id/mode_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Callout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/split_mode_off" />

                        <TextView
                            style="@style/Caption.1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/split_mode_off_desc"
                            android:textColor="#8C9197" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/mode_off_radio"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baseline_radio_button_unchecked_24"
                        app:tint="#5A5F6A" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mode_only"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Callout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/split_mode_only" />

                        <TextView
                            style="@style/Caption.1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/split_mode_only_desc"
                            android:textColor="#8C9197" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/mode_only_radio"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baseline_radio_button_unchecked_24"
                        app:tint="#5A5F6A" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/mode_except"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?android:attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="54dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="8dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/Callout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/split_mode_except" />

                        <TextView
                            style="@style/Caption.1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/split_mode_except_desc"
                            android:textColor="#8C9197" />

                    </LinearLayout>

                    <ImageView
                        android:id="@+id/mode_except_radio"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="12dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_baseline_radio_button_unchecked_24"
                        app:tint="#5A5F6A" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/only_empty_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/shape_rectangle_r16"
                android:backgroundTint="#1B1E24"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp"
                android:paddingVertical="10dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_warning"
                    app:tint="@color/blue" />

                <TextView
                    style="@style/Caption.1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:text="@string/split_tunnel_only_empty"
                    android:textColor="@color/white" />

            </LinearLayout>

            <TextView
                android:id="@+id/apps_header"
                style="@style/Caption.1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="4dp"
                android:textColor="#8C9197"
                tools:text="@string/split_tunnel_apps_via_vpn" />

        </LinearLayout>

        <!--
             Search row. In the expanded (full-screen list) state the header
             above is collapsed, so a back arrow appears to the left of the
             field — it is the visible way back to the normal screen (the
             system Back gesture works as well, see the OnBackPressedCallback
             in SplitTunnelFragment).
        -->
        <LinearLayout
            android:id="@+id/search_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btn_exit_expanded"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/split_tunnel_back"
                android:padding="6dp"
                android:src="@drawable/ic_arrow_left"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/search_container"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_search_glass" />

                <EditText
                    android:id="@+id/search_input"
                    style="@style/Callout"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/search"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:textColor="@color/white"
                    android:textColorHint="#8C9197" />

                <ImageView
                    android:id="@+id/clear_search"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/split_tunnel_clear_search"
                    android:padding="4dp"
                    android:src="@drawable/ic_close"
                    android:visibility="gone"
                    tools:visibility="visible" />

            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/apps_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/shape_rectangle_r24"
                android:backgroundTint="#1B1E24"
                android:clipToPadding="false"
                android:paddingVertical="8dp"
                android:scrollbars="none"
                tools:listitem="@layout/item_split_tunnel_app" />

            <TextView
                android:id="@+id/empty_view"
                style="@style/Subhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/split_tunnel_empty"
                android:visibility="gone"
                tools:visibility="visible" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/blue"
                android:indeterminateTintMode="src_atop" />

            <LinearLayout
                android:id="@+id/off_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="24dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_split_tunnel"
                    app:tint="#3A3F4A" />

                <TextView
                    style="@style/Subhead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="@string/split_tunnel_off_state" />

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</FrameLayout>
