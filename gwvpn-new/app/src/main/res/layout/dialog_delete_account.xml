<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center_horizontal"
    android:paddingHorizontal="16dp"
    android:background="@drawable/bg_welcome"
    >

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="148"
        />

    <ImageView
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:src="@drawable/img_heart_break"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/Title.1"
        android:layout_marginTop="16dp"
        android:text="@string/delete_account_title"
        android:textAlignment="center"
        />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/delete_account_subtitle"
        android:textAppearance="@style/Body"
        android:textColor="#8C9197"
        />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="108"
        />

    <Button
        android:id="@+id/stay"
        style="@style/Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="21dp"
        android:text="@string/delete_account_stay" />

    <Button
        android:id="@+id/delete"
        style="@style/Button.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/delete_account_confirm" />
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_weight="58"
        />

</LinearLayout>