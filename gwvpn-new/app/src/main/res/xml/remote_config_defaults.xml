<?xml version="1.0" encoding="utf-8"?>
<!--
    Значения по умолчанию для Firebase Remote Config.

    Эти значения используются, пока приложение ещё не скачало актуальный
    конфиг с сервера (первый запуск, нет сети и т.п.). Они совпадают с теми
    доменами, что раньше были «зашиты» в build.gradle, поэтому поведение
    приложения без Remote Config остаётся прежним.

    URL-значения закодированы (формат gwenc1:..., см. SecretCodec) — в APK
    нет открытых https:// строк. Новый клиент читает ТОЛЬКО ключи
    encrypted_* и игнорирует открытые api_base_url/payment_url/
    subscription_url (они нужны лишь старым версиям приложения).
-->
<defaultsMap>
    <!-- Дефолт — wildcard-маска: приложение само подставляет случайный
         субдомен и меняет его при блокировке. Актуальное значение живёт
         в консоли Firebase → Remote Config (api_base_url / payment_url). -->
    <entry>
        <key>encrypted_api_url</key>
        <value>gwenc1:smptfY6wacOdXop1z2vI0WWwb9nTsHqFtnPSoL1kxs1wtWC/1Gm0l7tijLw=</value>
    </entry>
    <entry>
        <key>encrypted_payment_url</key>
        <value>gwenc1:oX2xfbVltnLXxLFlhF5ikq/FbYK+sqVlx46sa8OdXop1z2vI0WWwb9nTsHqFtnPSoL1kxs1wtWC/1Gm0l7tijLw=</value>
    </entry>
    <entry>
        <key>encrypted_subscription_url</key>
        <value>gwenc1:m4q+fGrTXYZjw4x4gGejaX2QnWGCqrySpNChkNOxu3DZ1Gm0l7tijLw=</value>
    </entry>
    <!-- Периодический heartbeat /user/connection/update: интервал (сек,
         зажимается 15..240) и общий выключатель. -->
    <entry>
        <key>heartbeat_enabled</key>
        <value>true</value>
    </entry>
    <entry>
        <key>heartbeat_interval_seconds</key>
        <value>60</value>
    </entry>
    <!-- Окно «Доступно обновление» (AppUpdatePrompt). Пустое значение = выключено.
         update_latest_version — актуальная версия (versionName, напр. 3.1.5):
             если установленная ниже — при запуске показывается окно
             с кнопками «Обновить» / «Позже».
         update_min_version — минимально допустимая версия: если установленная
             ниже — окно без кнопки «Позже» (обязательное обновление).
         update_url — куда ведёт «Обновить» (открытый текст или gwenc1);
             пусто = страница приложения в Google Play.
         update_notes_ru / update_notes_en — необязательный блок «Что нового». -->
    <entry>
        <key>update_latest_version</key>
        <value></value>
    </entry>
    <entry>
        <key>update_min_version</key>
        <value></value>
    </entry>
    <entry>
        <key>update_url</key>
        <value></value>
    </entry>
    <entry>
        <key>update_notes_ru</key>
        <value></value>
    </entry>
    <entry>
        <key>update_notes_en</key>
        <value></value>
    </entry>
</defaultsMap>
