<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
>

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="com.android.vending.BILLING" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />


    <application
        android:name=".presentation.MyApp"
        tools:replace="android:label,android:icon,android:theme,android:allowBackup,android:usesCleartextTraffic,android:name,android:extractNativeLibs"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="true"
        android:extractNativeLibs="false"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme.NoActionBar"
        android:enableOnBackInvokedCallback="false">
        <!-- targetSdk 36 включает predictive back по умолчанию; старые androidx
             (activity 1.5.1 / navigation 2.5.3) не поддерживают OnBackInvokedCallback,
             поэтому явно оставляем классическое поведение кнопки «назад». -->
        <activity
            android:name=".presentation.ui.MainActivity"
            android:screenOrientation="portrait"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

<!--        <activity-->
<!--            android:name=".presentation.ui.LogViewerActivity"-->
<!--            android:label="Logs"-->
<!--            android:theme="@style/AppTheme.NoActionBar" />-->

        <!--
             The AdMob application ID is injected by the CAS Gradle plugin, which reads it from
             the CAS dashboard. Declaring it here would conflict with that.
        -->

        <service
            android:name=".presentation.ui.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- VyomVpnService is declared in vyom-tun-sdk module manifest -->

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_name" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/colorAccent" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/main_notif_channel_id" />


    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tg" />
        </intent>
        <!--
             Split Tunneling: enumerate user-visible (launchable) applications so the
             user can choose which of them bypass the VPN tunnel. Scoped <queries>
             declaration keeps us compliant with Google Play package-visibility
             policy without requesting the broad QUERY_ALL_PACKAGES permission.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

</manifest>