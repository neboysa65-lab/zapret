# ─── API сервера (тот же, что у бота) ────────────────────────────
API_BASE_URL=https://api-gwvpn-app.vpnhub.xyz

# Внутренний токен управления GW-нодами (X-Internal-Token).
# ДОЛЖЕН совпадать с INTERNAL_API_TOKEN в .env API-сервера.
INTERNAL_API_TOKEN=

# ─── JWT ─────────────────────────────────────────────────────────
# Сгенерируйте случайную строку: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_DAYS=7

# ─── Сервер панели ───────────────────────────────────────────────
PANEL_HOST=0.0.0.0
PANEL_PORT=8000
