# ── Телеграм-бот ────────────────────────────────────────────────────────────
BOT_TOKEN=
# Владельцы бота через запятую. Их нельзя снять через интерфейс.
ADMIN_IDS=
# Основной API проекта
API_BASE_URL=http://10.111.23.229:3002
# Внутренний токен управления GW-нодами (X-Internal-Token).
# ДОЛЖЕН совпадать с INTERNAL_API_TOKEN в .env API-сервера.
# Без него панель/бот не смогут просматривать и менять ssh/proxy/payload GW-нод.
INTERNAL_API_TOKEN=
# Веб-панель для кнопки Menu в Telegram (обязательно https)
PANEL_URL=https://api-gwvpn-app.vpnhub.xyz/adminka-android-api/login


# ── Мониторинг доступности серверов из РФ (GEOPinger API) ───────────────────
# Без GEOPINGER_URL модуль просто не запускается, остальной бот работает.
GEOPINGER_URL=http://57.129.126.169:8080
GEOPINGER_API_KEY=
# Проверка на стороне пингера идёт до 45 секунд — таймаут держим с запасом.
GEOPINGER_TIMEOUT=120
# Сколько проверок держим в воздухе одновременно. У самого пингера лимит
# GEOPINGER_MAX_CONCURRENCY (по умолчанию 4), выше него смысла нет.
GEOPINGER_CONCURRENCY=3

# Включение модуля и частота обхода всех адресов (секунды).
MONITOR_ENABLED=1
MONITOR_INTERVAL_SEC=300

# Сколько точек опрашиваем внутри РФ. Больше точек = точнее картина, но
# дольше цикл. Шесть — разумный баланс.
MONITOR_RU_POINTS=6
# Контрольная группа за пределами РФ: по ней отличаем блокировку в России
# от падения самого сервера. Запрашивается только когда РФ молчит полностью.
MONITOR_CONTROL_COUNTRIES=kz,br,in,za
MONITOR_CONTROL_POINTS=4

# Доля успешных точек РФ, при которой сервер считается доступным.
MONITOR_OK_RATIO=0.5
# Сколько подряд неудачных обходов нужно, чтобы поднять тревогу (2 = 10 минут).
# Защита от единичных сетевых мигов и подвисших точек.
MONITOR_FAIL_STREAK=2
# Сколько удачных обходов нужно, чтобы закрыть инцидент.
MONITOR_OK_STREAK=1

# Порты для TCP-проверок — везде 22. IKEv2 (UDP 500/4500) и AWG (UDP)
# снаружи не пощупать: у UDP нет рукопожатия, «нет ответа» и «дошло, но
# молчит» неотличимы. Поэтому о доступности узла судим по управляющему
# TCP-порту: не доходит до него — не доходит и до сервера.
MONITOR_IKEV2_PORTS=22
MONITOR_AWG_PORTS=22
MONITOR_VLESS_PORTS=22
# Дополнительно проверять у VLESS рабочий порт из настроек сервера (8443 и
# подобные). По умолчанию выключено — проверяем только 22.
MONITOR_VLESS_USE_CONFIG_PORT=0

# Проверять ли серверы, выключенные в панели.
MONITOR_INCLUDE_DISABLED=0

# Суточная сводка: время и часовой пояс (3 = МСК).
MONITOR_REPORT_TIME=23:50
MONITOR_TZ_OFFSET=3

# Напоминать о незакрытых инцидентах раз в N часов (0 — не напоминать).
MONITOR_REMIND_HOURS=6
# С какого числа одновременно упавших серверов слать одно сводное сообщение
# вместо отдельного алерта по каждому.
MONITOR_MASS_MIN=3
# Файл состояния: открытые инциденты переживают перезапуск бота.
# MONITOR_STATE_FILE=/var/lib/gwbot/monitor_state.json
